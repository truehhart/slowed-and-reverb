{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slowed and Reverb",
  "version": "0.1.0",
  "identifier": "com.truehhart.slowed-and-reverb",
  "build": {
    "beforeDevCommand": "mise run prepare:sidecars && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "mise run prepare:sidecars && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Slowed and Reverb",
        "width": 980,
        "height": 620,
        "minWidth": 980,
        "minHeight": 620,
        "maxWidth": 980,
        "maxHeight": 620,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      },
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "binaries/yt-dlp": "yt-dlp",
      "binaries/_internal": "_internal"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
